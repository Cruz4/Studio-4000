+void EditPlaybackContext::nextBlockStarted (int numSamples)
+{
+    CRASH_TRACER
+
+    SCOPED_REALTIME_CHECK
+    if (! nodePlaybackContext)
+        return;
+
+    // Studio 4000: align capture and playback to the same block before dispatching play.
+    // Advancing the reference range after input capture made a start-up position reset
+    // shift recorded audio by one buffer, depending on which callback saw the reset.
+    nodePlaybackContext->updateReferenceSampleRange (numSamples);
+
+    if (edit.isRendering())
+        return;
+
+    nodePlaybackContext->nextBlockStarted();
+}
