         /** Adss a block of recorded data to the thumbnail.
@@ -51,8 +51,21 @@
         */
         void addBlock (const juce::AudioBuffer<float>& incoming, int startOffsetInBuffer, int numSamples)
         {
-            thumb->addBlock (nextSampleNum, incoming, startOffsetInBuffer, numSamples);
-            nextSampleNum += numSamples;
+            // Studio 4000: accumulate partial thumbnail bins so later silence cannot
+            // overwrite an earlier transient. Publish the partial bin too for live drawing.
+            while (numSamples > 0)
+            {
+                const int count = juce::jmin (pending.getNumSamples() - pendingSamples, numSamples);
+                for (int channel = 0; channel < juce::jmin (pending.getNumChannels(), incoming.getNumChannels()); ++channel)
+                    pending.copyFrom (channel, pendingSamples, incoming, channel, startOffsetInBuffer, count);
+                pendingSamples += count;
+                nextSampleNum += count;
+                thumb->addBlock (nextSampleNum.load() - pendingSamples, pending, 0, pendingSamples);
+                startOffsetInBuffer += count;
+                numSamples -= count;
+                if (pendingSamples == pending.getNumSamples())
+                    pendingSamples = 0;
+            }
         }
 
